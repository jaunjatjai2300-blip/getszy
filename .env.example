# ================================================================
# GETSZY - Root Environment Variables
# ================================================================
# Copy this to .env and fill in real values
# NEVER commit .env to git

# --- Domain ---
DOMAIN=getszy.com
PUBLIC_URL=https://getszy.com

# --- Backend ---
MONGO_URL=mongodb://mongo:27017
DB_NAME=getszy_db
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
CORS_ORIGINS=https://getszy.com,https://www.getszy.com

# --- Seed credentials (only for initial setup) ---
SEED_ADMIN_EMAIL=admin@getszy.com
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
SEED_CUSTOMER_EMAIL=customer@getszy.com
SEED_CUSTOMER_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# --- AI Providers (use your existing API keys) ---
# Groq (free, fast, 11K req/day)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (free tier, 92+ models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# HuggingFace (free inference)
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Gemini Studio (free, 1500 req/day)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local models on VPS, runs on host port 11434)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_2=
OLLAMA_MODEL_3=mistral

# --- Cost Guard ---
FREE_ONLY=true
# Primary provider. Leave "auto" to use the fastest available free provider,
# or pin "groq" (free GPU, ~500 tok/s) for dramatically faster video generation:
#   LLM_PROVIDER=groq
LLM_PROVIDER=auto

# --- GitHub Deploy ---
GITHUB_TOKEN=
GITHUB_REPO=jaunjatjai2300-blip/getszy
GITHUB_BRANCH=main
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_TOKEN=

# --- Razorpay (subscriptions) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ELITE=

# --- Debug ---
ENABLE_DOCS=0
LOG_LEVEL=INFO

# --- Video Factory speed tuning ---
# Output-token caps per stage (smaller = faster, especially on CPU Ollama).
FACTORY_ENHANCE_MAX_TOKENS=600
FACTORY_RESEARCH_MAX_TOKENS=900
FACTORY_SCRIPT_MAX_TOKENS=1800
FACTORY_HOOKS_MAX_TOKENS=800
FACTORY_STORYBOARD_MAX_TOKENS=1500
FACTORY_VISUALS_MAX_TOKENS=1200
# How many of the 5 script variants generate at once. CPU Ollama: keep low (3);
# GPU/Groq: raise to 5 to fully parallelize.
FACTORY_SCRIPT_CONCURRENCY=3
