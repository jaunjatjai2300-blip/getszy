# Getszy — reference Caddy config (deploy-side)
#
# Dropshipping + courses + AI platform. Serves the built React SPA and reverse
# proxies the FastAPI backend. Place this on the VPS (e.g. /etc/caddy/Caddyfile)
# or import it. Adjust domains/paths to your environment.
#
# Build the frontend first: cd frontend && npm ci && craco build  (-> build/)

{
    # Uncomment to enable automatic HTTPS with a real domain.
    # email you@example.com
}

getszy.com, www.getszy.com {

    # ── Static SPA ──────────────────────────────────────────────────────────
    root * /opt/getszy/legacy-getszy/frontend/build
    encode gzip

    # SPA fallback: serve index.html for client-side routes.
    try_files {path} /index.html

    # ── Security headers (covers served HTML + static assets) ────────────────
    header {
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.getszy.com; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # ── API reverse proxy ────────────────────────────────────────────────────
    handle_path /api/* {
        reverse_proxy localhost:8000
    }

    # ── Media / uploaded assets (if served by backend) ──────────────────────
    handle_path /media/* {
        reverse_proxy localhost:8000
    }

    file_server
}

# Optional: api subdomain -> backend (used if REACT_APP_BACKEND_URL=https://api.getszy.com)
api.getszy.com {
    reverse_proxy localhost:8000

    header {
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
