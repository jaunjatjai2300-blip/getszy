[Unit]
Description=Getszy Deploy Webhook Listener
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/getszy/deploy
# Token comes from the repo's .env (kept 600 root-owned) so it is never baked
# into the unit file. .env must define WEBHOOK_TOKEN; update-vps-token.sh
# maintains it alongside DEPLOY_WEBHOOK_TOKEN/GITHUB_TOKEN.
EnvironmentFile=/opt/getszy/legacy-getszy/.env
Environment="REPO_DIR=/opt/getszy"
Environment="WEBHOOK_PORT=9000"
ExecStart=/usr/bin/python3 /opt/getszy/deploy/webhook_listener.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
