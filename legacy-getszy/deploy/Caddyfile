getszy.com, www.getszy.com, dash.getszy.com {
    encode gzip

    header {
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://*.getszy.com; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    handle /api/* {
        reverse_proxy backend:8001
    }

    @docs path /docs /docs/* /redoc /redoc/* /openapi.json

    handle @docs {
        reverse_proxy backend:8001
    }

    handle /hooks/* {
        uri strip_prefix /hooks
        reverse_proxy host.docker.internal:9000
    }

    handle {
        reverse_proxy frontend:80
    }

    log {
        output stdout
        format console
        level INFO
    }
}
