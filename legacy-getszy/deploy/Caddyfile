getszy.com, www.getszy.com, dash.getszy.com {
    encode gzip

    header {
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://assets.emergent.sh; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.getszy.com https://assets.emergent.sh; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Production documentation is available only from an authenticated internal
    # environment; never publish API schemas or interactive docs to the internet.
    @internal_docs path /docs /docs/* /redoc /redoc/* /openapi.json /api/docs /api/docs/* /api/redoc /api/redoc/* /api/openapi.json
    handle @internal_docs {
        respond "Not Found" 404
    }

    handle /api/* {
        reverse_proxy backend:8001
    }

    handle /hooks/* {
        uri strip_prefix /hooks
        reverse_proxy host.docker.internal:9000
    }

    handle {
        reverse_proxy frontend:80
    }

    log {
        output stdout
        format console
        level INFO
    }
}
