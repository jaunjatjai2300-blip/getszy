# ================================================================
# GETSZY - Legacy Backend Environment Variables
# ================================================================
# Copy this to .env inside legacy-getszy/ and fill in real values
# NEVER commit .env to git

# --- Backend ---
MONGO_URL=mongodb://mongo:27017
DB_NAME=getszy_db
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
CORS_ORIGINS=https://getszy.com,https://www.getszy.com

# --- Frontend build ---
# Leave empty to use relative URLs (recommended with Caddy reverse proxy)
PUBLIC_URL=

# --- Domain (for Caddy TLS) ---
DOMAIN=getszy.com

# --- Seed credentials (REQUIRED for first run) ---
SEED_ADMIN_EMAIL=admin@getszy.com
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
SEED_CUSTOMER_EMAIL=customer@getszy.com
SEED_CUSTOMER_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# --- AI / LLM ---
FREE_ONLY=true
LLM_PROVIDER=ollama

# Ollama (local, free — your VPS models)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_2=qwen2.5-coder:14b
OLLAMA_MODEL_3=llama3.2:3b

# Groq (free, fast fallback — get key at console.groq.com)
GROQ_API_KEY=

# Gemini (free fallback — get key at aistudio.google.com)
GEMINI_API_KEY=

# LM Studio (local, free — OpenAI-compatible, e.g. longcat2.0)
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=longcat2.0

# OpenRouter (your credits, many models — get key at openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# --- GitHub Deploy ---
GITHUB_TOKEN=
GITHUB_REPO=jaunjatjai2300-blip/getszy
GITHUB_BRANCH=main
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_TOKEN=

# --- Razorpay (subscriptions) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_LITE=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ELITE=
RAZORPAY_PLAN_ULTRA=
# Creator Pass (₹299/mo) — create via POST /api/billing/admin/create-plans or set here
RAZORPAY_PLAN_CREATOR=

# --- Creator / Video features (Phase 1/2) ---
# HF_TOKEN (FREE) unlocks FLUX images, XTTS voice clone, SadTalker avatar, CogVideoX.
# Get one at huggingface.co/settings/tokens — WITHOUT THIS, avatars/images return 503.
HF_TOKEN=
# Media provider tier: free (Pollinations/HF) | fal | replicate | gpu
MEDIA_PROVIDER=free
FAL_KEY=
REPLICATE_TOKEN=
# Self-hosted GPU box exposing POST /lipsync (video+audio) -> {video_url}. Enables real lip-sync.
GPU_HOST=
# Whisper STT (OpenAI or HF) for YouTube transcript auto-extract in one-tap repurposing.
OPENAI_API_KEY=
# One-click social distribution (tokens are saved per-user via /social-connect at runtime).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Web search tools (optional)
TAVILY_API_KEY=
BRAVE_API_KEY=

# NOTE: ffmpeg + yt-dlp are pre-installed in the backend image. Mongo runs as a
# replica set (rs0) so catalog-to-video change streams work.

# --- Emergent (paid fallback, disabled by default) ---
EMERGENT_LLM_KEY=
EMERGENT_MODEL=gpt-4o-mini

# --- Observability ---
SENTRY_DSN=
LOGTAIL_KEY=

# --- Redis (distributed rate limiter + state) ---
REDIS_URL=redis://redis:6379/0

# --- Per-user AI rate limiter (Redis-backed, multi-worker safe) ---
AI_RATE_LIMIT_PER_USER=30
AI_RATE_WINDOW_SEC=60

# --- Credit safety ---
# Hard ceiling on a single credit grant (manual grant OR payment webhook).
MAX_CREDIT_GRANT=1000000

# --- Backups (GFS: daily/weekly/monthly) ---
# Local logical backups live in BACKUP_DIR (mounted volume; see docker-compose).
BACKUP_DIR=/app/backups
BACKUP_INTERVAL_HOURS=4
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=5
BACKUP_RETENTION_MONTHLY=12
# Encrypt backup files at rest with Fernet (cryptography). Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to write plaintext (NOT recommended — backups contain PII).
BACKUP_ENCRYPTION_KEY=
# Off-site S3 / S3-compatible (AWS, Cloudflare R2, Wasabi, MinIO).
# Set BACKUP_S3_BUCKET to ENABLE off-site sync (no-op when empty).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=getszy-backups

# --- DPDP data-deletion worker ---
# Grace period (days) before a /data-delete request is actually erased.
DELETION_GRACE_DAYS=30

# --- Request-log writer (bounded to avoid OOM under DDoS) ---
REQUEST_LOG_MAX_CONCURRENT=50

# --- Monitoring / alerting ---
# Real alert sink (Slack/Discord/Mattermost/PagerDuty incoming webhook).
ALERT_WEBHOOK_URL=
GRAFANA_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
