# ---- Build stage ----
FROM python:3.11-slim AS builder

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Build deps (not needed at runtime)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /build/requirements.txt
# PyPI only. emergentintegrations (optional paid LLM provider) lives on a
# private CloudFront-hosted index, but it's deliberately commented out of
# requirements.txt (see the comment there: "Install separately if needed") —
# so there's nothing here that needs a second index. A prior version of this
# line passed --extra-index-url unconditionally, which would have let pip
# resolve *every* package below against that third-party index too, and
# prefer whichever index reports the higher version for a given name (classic
# dependency confusion). If emergentintegrations is ever wired back in as a
# real dependency, add its install back deliberately and scope the extra
# index to that one pinned package only — don't widen this line again.
RUN pip install --prefix=/install -r requirements.txt

# ---- Runtime stage ----
FROM python:3.11-slim

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Runtime deps only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp for YouTube transcript ingest (one-tap repurposing)
RUN pip install --no-cache-dir yt-dlp

# Non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

COPY backend/ /app/

RUN chown -R appuser:appgroup /app

RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -e' \
    'mkdir -p /app/backend/media/audio /app/backend/media/video /app/backend/media/images /app/backend/media/avatars /app/backups' \
    'chown -R appuser:appgroup /app/backend/media /app/backups 2>/dev/null || true' \
    'if command -v runuser >/dev/null 2>&1; then' \
    '  exec runuser -u appuser -- "$@"' \
    'fi' \
    'exec "$@"' > /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8001/api/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
